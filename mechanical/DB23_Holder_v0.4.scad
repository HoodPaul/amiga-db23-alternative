// DB23 replacement v0.4: UNMEASURED CONNECTOR FIT PROTOTYPE
// Generated by source/build_mechanical.py from source/design_parameters.json.
// mm; x across port, y inward from flange, z above motherboard top.
// Genuine solder-cup connector must be measured before declaring a fit.
// Cable-facing thread: 4-40 UNC. Captive nut matches ACTUAL rear stem.
// Guide diameter 0.92 is nominal geometry: printer compensation is separate.
// For 0.64 square pins, theoretical minimum circle is 0.9051 mm before clearance.
// Main holder bottom is z=0.6. Fit the two supplied 0.6 mm anchor shims below it.
// Export examples: openscad -o holder.stl -D 'part="holder"' this_file.scad
// Choose holder, coupon, nut_keeper, anchor_shims, anchor_shim, pin_height_jig, or assembly.
part="holder";
$fn=64;
overall_width=52.0;
front_y=0.65;
rear_y=15.6;
bottom_z=0.6;
pin_block_width=35.5;
pin_block_front_y=7.1;
pin_block_rear_y=12.5;
pin_block_top_z=4.5;
guide_d=0.92;
anchor_x=22.135;
anchor_y=9.5;
anchor_d=3.3;
jackpost_d=3.2;
nut_af=5.5;
nut_t=2.4;
nut_clearance=0.2;
nut_y=3.0;
nut_z=6.25;
pcb_bottom_z=5.75;
pcb_half_width=20.0;
shield_x=18.0;
rail_inner_x=17.25;
rail_front_inner_x=18.6;
rail_step_y=7.1;
rail_top_z=5.75;
tower_inner_x=18.6;
tower_rear_y=4.8;
tower_top_z=11.0;
anchor_boss_top_z=5.75;
anchor_head_seat_z=2.4;
anchor_head_pocket_diameter=6.4;
anchor_head_pocket_open_outboard=true;
anchor_head_max_diameter=6.0;
anchor_head_max_height=3.0;
rear_infill_front_y=12.5;
rear_infill_top_z=5.75;
pcb_lateral_clearance=0.25;
pcb_stop_wall_width=0.8;
pcb_stop_top_above_seat=0.65;
pcb_stop_front_y=12.5;
shield_relief_width=4.4;
shield_relief_front_y=11.8;
shield_relief_rear_y=14.8;
shield_relief_floor_z=4.5;
keeper_height=1.2;
keeper_tongue_length=1.2;
keeper_fit_clearance=0.15;
jig_overall_width=56.0;
jig_front_y=-1.35;
jig_rear_y=17.6;
jig_floor_thickness=3.0;
jig_tip_stop_z=-3.2;
jig_support_top_z=0.6;
jig_support_inner_x=19.0;
jig_support_front_y=0.65;
jig_support_rear_y=15.6;
jig_locating_peg_diameter=2.9;
jig_locating_peg_height=1.2;
jig_print_z_offset=6.2;
pin_grid=[[-15.235, 10.92], [-12.465, 10.92], [-9.695, 10.92], [-6.924999999999999, 10.92], [-4.154999999999999, 10.92], [-1.3849999999999998, 10.92], [1.3850000000000016, 10.92], [4.155000000000001, 10.92], [6.925000000000001, 10.92], [9.695, 10.92], [12.465, 10.92], [15.235, 10.92], [-13.85, 8.08], [-11.08, 8.08], [-8.309999999999999, 8.08], [-5.539999999999999, 8.08], [-2.7699999999999996, 8.08], [0.0, 8.08], [2.7700000000000014, 8.08], [5.540000000000001, 8.08], [8.31, 8.08], [11.08, 8.08], [13.85, 8.08]];

eps=0.03;
nut_pocket_af=nut_af+nut_clearance;
nut_pocket_t=nut_t+nut_clearance;
nut_R=nut_pocket_af/sqrt(3);
nut_y0=nut_y-nut_pocket_t/2;
nut_y1=nut_y+nut_pocket_t/2;
function hexpts(af)=[for(a=[30:60:330]) [af/sqrt(3)*cos(a),af/sqrt(3)*sin(a)]];
module box(x0,x1,y0,y1,z0,z1) {
 translate([x0,y0,z0]) cube([x1-x0,y1-y0,z1-z0]);
}
module zhole(x,y,d,z0,z1){translate([x,y,z0]) cylinder(d=d,h=z1-z0);}
module yhole(x,z,d,y0,y1){
 translate([x,y0,z]) rotate([-90,0,0]) cylinder(d=d,h=y1-y0);
}
module nut_slot(x){
 // Hex points project to X/Z; inspect wall thickness after changing nut sizes.
 translate([x,nut_y1,nut_z]) rotate([90,0,0])
   linear_extrude(height=nut_pocket_t) polygon(hexpts(nut_pocket_af));
 // Top-loading continuation of the pocket. Screw stem retains the nut once fitted.
 box(x-nut_pocket_af/2,x+nut_pocket_af/2,nut_y0,nut_y1,
     nut_z,tower_top_z+eps);
}
module holder(){difference(){union(){
 // A thick 23-pin block joins both rails and the filled rear bridge.
 box(-pin_block_width/2,pin_block_width/2,pin_block_front_y,
     pin_block_rear_y,bottom_z,pin_block_top_z);
 for(s=[-1,1]){
   if(s==1){
     // Forward rails clear the unmeasured body/cup envelope.
     box(rail_front_inner_x,overall_width/2,front_y,rail_step_y,bottom_z,rail_top_z);
     box(rail_inner_x,overall_width/2,rail_step_y,rear_y,bottom_z,rail_top_z);
     box(tower_inner_x,overall_width/2,front_y,tower_rear_y,bottom_z,tower_top_z);
   }else{
     box(-overall_width/2,-rail_front_inner_x,front_y,rail_step_y,bottom_z,rail_top_z);
     box(-overall_width/2,-rail_inner_x,rail_step_y,rear_y,bottom_z,rail_top_z);
     box(-overall_width/2,-tower_inner_x,front_y,tower_rear_y,bottom_z,tower_top_z);
   }
   translate([s*anchor_x,anchor_y,bottom_z])
     cylinder(d=overall_width-2*anchor_x,h=anchor_boss_top_z-bottom_z);
 }
 // The old open rear window is completely filled, except shallow pad reliefs.
 box(-pcb_half_width,pcb_half_width,rear_infill_front_y,rear_y,
     bottom_z,rear_infill_top_z);
 box(pcb_half_width+pcb_lateral_clearance,pcb_half_width+pcb_lateral_clearance+pcb_stop_wall_width,
     pcb_stop_front_y,rear_y,bottom_z,pcb_bottom_z+pcb_stop_top_above_seat);
 box(-pcb_half_width-pcb_lateral_clearance-pcb_stop_wall_width,-pcb_half_width-pcb_lateral_clearance,
     pcb_stop_front_y,rear_y,bottom_z,pcb_bottom_z+pcb_stop_top_above_seat);
 }
 for(p=pin_grid) zhole(p[0],p[1],guide_d,bottom_z-eps,pin_block_top_z+eps);
 for(s=[-1,1]){
   zhole(s*anchor_x,anchor_y,anchor_d,bottom_z-eps,tower_top_z+eps);
   // Recessed low head seats preserve PCB clearance. Open the pockets outboard
   // so no fragile thin outer lip is left. Preload bolts before lowering PCB.
   zhole(s*anchor_x,anchor_y,anchor_head_pocket_diameter,anchor_head_seat_z,tower_top_z+eps);
   if(anchor_head_pocket_open_outboard){
   if(s==1) box(anchor_x,overall_width/2+eps,anchor_y-anchor_head_pocket_diameter/2,
                anchor_y+anchor_head_pocket_diameter/2,anchor_head_seat_z,tower_top_z+eps);
   else box(-overall_width/2-eps,-anchor_x,anchor_y-anchor_head_pocket_diameter/2,
            anchor_y+anchor_head_pocket_diameter/2,anchor_head_seat_z,tower_top_z+eps);
   }
   yhole(s*anchor_x,nut_z,jackpost_d,front_y-eps,tower_rear_y+eps);
   nut_slot(s*anchor_x);
   // Local top recesses leave a continuous floor under the shield-pad joints.
   box(s*shield_x-shield_relief_width/2,s*shield_x+shield_relief_width/2,
       shield_relief_front_y,shield_relief_rear_y,shield_relief_floor_z,pcb_bottom_z+1);
 }
}}
module pin_height_jig_assembly(){
 // Common flat floor at tip_stop_z. The open central well accepts all23 tips.
 // Support ledges set holder underside height; loose pegs only locate the jig.
 union(){
   box(-jig_overall_width/2,jig_overall_width/2,jig_front_y,jig_rear_y,
       jig_tip_stop_z-jig_floor_thickness,jig_tip_stop_z);
   for(s=[-1,1]){
     if(s==1) box(jig_support_inner_x,jig_overall_width/2,
       jig_support_front_y,jig_support_rear_y,jig_tip_stop_z,jig_support_top_z);
     else box(-jig_overall_width/2,-jig_support_inner_x,
       jig_support_front_y,jig_support_rear_y,jig_tip_stop_z,jig_support_top_z);
     zhole(s*anchor_x,anchor_y,jig_locating_peg_diameter,
       jig_support_top_z-eps,jig_support_top_z+jig_locating_peg_height);
   }
 }
}
module nut_keeper(){
 // Print two. Loose keeper is optional; fitted jackpost stem already traps its nut.
 w=overall_width/2-tower_inner_x;
 union(){
   box(-w/2,w/2,front_y,tower_rear_y,0,keeper_height);
   box(-nut_pocket_af/2+keeper_fit_clearance/2,
        nut_pocket_af/2-keeper_fit_clearance/2,
        nut_y0+keeper_fit_clearance/2,nut_y1-keeper_fit_clearance/2,
        -keeper_tongue_length,eps);
 }
}
module anchor_shims(){
 for(s=[-1,1]) difference(){
   translate([s*5,0,0]) cylinder(d=7,h=bottom_z);
   zhole(s*5,0,anchor_d,-eps,bottom_z+eps);
 }
}
module coupon(){
 // Actual 23-hole staggered grid plus eight independent hole-size trials.
 difference(){
   box(-21,21,0,22,0,3);
   for(i=[0:7]) zhole(-16.8+i*4.8,5,0.75+i*0.05,-eps,3+eps);
   for(p=pin_grid) zhole(p[0],p[1]+5.4,guide_d,-eps,3+eps);
 }
 for(i=[0:7]) translate([-16.8+i*4.8,1.7,2.99])
   linear_extrude(0.36) text(str(0.75+i*0.05),size=1.3,
     halign="center",valign="center",font="DejaVu Sans:style=Bold");
 translate([0,20,2.99]) linear_extrude(0.36)
   text(str("23-PIN GRID  ",guide_d),size=1.65,
     halign="center",valign="center",font="DejaVu Sans:style=Bold");
}
if(part=="holder") holder();
if(part=="coupon") coupon();
// Keeper exports with its broad flat cap on the bed and the tongue upwards.
if(part=="nut_keeper") translate([0,0,keeper_height]) rotate([0,180,0]) nut_keeper();
if(part=="anchor_shims") anchor_shims();
if(part=="anchor_shim") difference(){cylinder(d=7,h=bottom_z);zhole(0,0,anchor_d,-eps,bottom_z+eps);}
if(part=="pin_height_jig") translate([0,0,jig_print_z_offset]) pin_height_jig_assembly();
if(part=="assembly"){
 color("grey") holder();
 for(s=[-1,1]) color("orange")
   translate([s*anchor_x,0,tower_top_z]) nut_keeper();
 for(s=[-1,1]) color("orange") translate([s*anchor_x,anchor_y,0])
   difference(){cylinder(d=7,h=bottom_z);zhole(0,0,anchor_d,-eps,bottom_z+eps);}
}
